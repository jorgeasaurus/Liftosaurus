# Runtime URL (Supabase pooled/transaction mode, keep pgbouncer=true)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma CLI URL (Supabase direct connection, no pgbouncer=true)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Can be generated using `npx auth secret` (compulsory)
AUTH_SECRET="xxxxxxxx"

# The following are not compulsory (if having direct DB access)
# See src/lib/utils/userCreation.ts to create users directly (run in to get a test user)

# https://authjs.dev/getting-started/providers/github
AUTH_GITHUB_ID="xxxxxx"
AUTH_GITHUB_SECRET="xxxxxx"

# Local development only: exposes an Agent test account option in the login menu.
AGENT_LOGIN_ENABLED="false"

# https://authjs.dev/getting-started/providers/google 
AUTH_GOOGLE_ID="xxxxxx"
AUTH_GOOGLE_SECRET="xxxxxx"